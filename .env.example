# Groq API key (for Summarize / Q&A / Quiz)
GROQ_API_KEY=your_groq_api_key_here

# Path to your Google Service Account JSON file (for Study Planner -> Google Sheets)
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The Google Sheet's name or URL (must be shared with the Service Account's email)
STUDY_PLANNER_SHEET_NAME=StudyPlannerData
